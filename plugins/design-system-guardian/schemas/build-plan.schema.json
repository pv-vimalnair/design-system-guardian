{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-system-guardian.local/schemas/build-plan.schema.json",
  "title": "Design System Guardian build plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "profileId",
    "snapshotId",
    "policyDigest",
    "uxDecision",
    "selections",
    "sentinels",
    "productionReady"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"type": "string", "minLength": 1},
    "profileId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "snapshotId": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policyDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uxDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hierarchy", "states", "accessibility", "componentIntent"],
      "properties": {
        "hierarchy": {"$ref": "#/$defs/decisionItems"},
        "states": {"$ref": "#/$defs/decisionItems"},
        "accessibility": {"$ref": "#/$defs/decisionItems"},
        "componentIntent": {"$ref": "#/$defs/decisionItems"}
      }
    },
    "selections": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "resolution.schema.json"},
          {
            "properties": {
              "status": {"const": "allowed"},
              "selectedIdentity": {"type": "string", "minLength": 1},
              "sentinel": {"const": null}
            }
          }
        ]
      }
    },
    "sentinels": {
      "type": "array",
      "items": {"$ref": "resolution.schema.json#/$defs/sentinel"}
    },
    "productionReady": {"type": "boolean"}
  },
  "$defs": {
    "decisionItems": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
