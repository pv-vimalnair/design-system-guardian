{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-system-guardian.local/schemas/judgment-history-head.schema.json",
  "title": "Design System Guardian current judgment history head",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "runId", "sequence", "recordDigest", "assessmentDigest", "activeDecisionDigest", "authoritySeal"],
  "properties": {
    "schemaVersion": {"const": 1},
    "profileId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "runId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 99999999},
    "recordDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assessmentDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "activeDecisionDigest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "authoritySeal": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}