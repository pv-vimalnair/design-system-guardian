{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-system-guardian.local/schemas/run-manifest.schema.json",
  "title": "Design System Guardian run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "profileId",
    "snapshotId",
    "policyDigest",
    "command",
    "startedAt",
    "completedAt",
    "sourceCut",
    "projectEvidence",
    "enforcementAuthorityLane",
    "inputs",
    "outputs",
    "exitCode",
    "productionReady"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"type": "string", "minLength": 1},
    "profileId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "snapshotId": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policyDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "command": {"const": "finalize"},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "sourceCut": {"$ref": "#/$defs/sourceCut"},
    "projectEvidence": {"$ref": "#/$defs/projectEvidence"},
    "enforcementAuthorityLane": {"$ref": "#/$defs/enforcementAuthorityLane"},
    "inputs": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/input"}
    },
    "outputs": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/output"}
    },
    "exitCode": {"type": "integer", "minimum": 0, "maximum": 4},
    "productionReady": {"type": "boolean"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "projectEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalRoot", "rootIdentity", "gitCommit", "assessedTreeDigest", "analysisInputsDigest"],
      "properties": {
        "canonicalRoot": {"type": "string", "minLength": 1},
        "rootIdentity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "gitCommit": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}]},
        "assessedTreeDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "analysisInputsDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "enforcementAuthorityLane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "status", "provider", "attestation"],
      "properties": {
        "schemaVersion": {"const": 1},
        "status": {"const": "not_assessed"},
        "provider": {"type": "null"},
        "attestation": {"type": "null"}
      }
    },
    "sourceCut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["figmaFiles", "catalogDigest", "codeConnectParseDigest", "repositoryCommit", "componentCatalogBuild"],
      "properties": {
        "figmaFiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fileKey", "version"],
            "properties": {
              "fileKey": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          }
        },
        "catalogDigest": {"$ref": "#/$defs/digest"},
        "codeConnectParseDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "repositoryCommit": {"type": ["string", "null"], "minLength": 1},
        "componentCatalogBuild": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactType", "digest"],
      "properties": {
        "artifactType": {"enum": ["run-pin", "analysis-attestation", "audit-result", "build-plan"]},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactType", "path", "payloadDigest"],
      "properties": {
        "artifactType": {"enum": ["audit-result", "coverage", "build-plan", "readable-report"]},
        "path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "payloadDigest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
