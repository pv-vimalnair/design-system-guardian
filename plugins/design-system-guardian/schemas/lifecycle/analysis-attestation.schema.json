{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-system-guardian.local/schemas/lifecycle/analysis-attestation.schema.json",
  "title": "Design System Guardian trusted analysis attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "profileId",
    "snapshotId",
    "policyDigest",
    "configDigest",
    "runnerEvidenceDigest",
    "runnerEvidence",
    "auditResultDigest"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"type": "string", "minLength": 1},
    "profileId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "snapshotId": {"$ref": "#/$defs/digest"},
    "policyDigest": {"$ref": "#/$defs/digest"},
    "configDigest": {"$ref": "#/$defs/digest"},
    "runnerEvidenceDigest": {"$ref": "#/$defs/digest"},
    "runnerEvidence": {"type": "object"},
    "auditResultDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
