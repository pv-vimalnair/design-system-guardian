{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-system-guardian.local/schemas/judgment-assessment.schema.json",
  "title": "Design System Guardian judgment assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "runId", "profileId", "bindings", "activeRuleIds",
    "target", "instances", "rawStatus", "complete", "nonJudgmentBlockersClear"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"$ref": "#/$defs/text128"},
    "profileId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runPinDigest", "profileDigest", "policyDigest", "snapshotDigest",
        "sourceCutDigest", "ruleSnapshotDigest", "activeRuleSetDigest",
        "evaluatorContractDigest", "analysisAttestationDigest", "auditResultDigest",
        "targetDigest", "evidenceDigest"
      ],
      "properties": {
        "runPinDigest": {"$ref": "#/$defs/digest"},
        "profileDigest": {"$ref": "#/$defs/digest"},
        "policyDigest": {"$ref": "#/$defs/digest"},
        "snapshotDigest": {"$ref": "#/$defs/digest"},
        "sourceCutDigest": {"$ref": "#/$defs/digest"},
        "ruleSnapshotDigest": {"$ref": "#/$defs/digest"},
        "activeRuleSetDigest": {"$ref": "#/$defs/digest"},
        "evaluatorContractDigest": {"$ref": "#/$defs/digest"},
        "analysisAttestationDigest": {"$ref": "#/$defs/digest"},
        "auditResultDigest": {"$ref": "#/$defs/digest"},
        "targetDigest": {"$ref": "#/$defs/digest"},
        "evidenceDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "activeRuleIds": {
      "type": "array", "maxItems": 4096, "uniqueItems": true,
      "items": {"$ref": "#/$defs/ruleId"}
    },
    "target": {"$ref": "#/$defs/finalFlowTarget"},
    "instances": {
      "type": "array", "maxItems": 8192, "uniqueItems": true,
      "items": {"$ref": "#/$defs/instance"}
    },
    "rawStatus": {"$ref": "#/$defs/status"},
    "complete": {"type": "boolean"},
    "nonJudgmentBlockersClear": {"type": "boolean"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stableId": {"type": "string", "pattern": "^(?:target|instance|finding)-[0-9a-f]{24}$"},
    "ruleId": {
      "type": "string", "minLength": 1, "maxLength": 127,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "text128": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
    "text256": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"},
    "text2048": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "\\S"},
    "status": {"enum": ["allowed", "conflict", "not_assessed"]},
    "finalFlowTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["flowDigest", "screenDigests"],
      "properties": {
        "flowDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "screenDigests": {
          "type": "array", "maxItems": 256, "uniqueItems": true,
          "items": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "appliesTo": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind"], "properties": {"kind": {"const": "system"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "category"],
          "properties": {"kind": {"const": "category"}, "category": {"$ref": "#/$defs/text128"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "identity"],
          "properties": {
            "kind": {"enum": ["component", "icon", "token"]},
            "identity": {"$ref": "#/$defs/text256"}
          }
        }
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["targetId", "kind", "scope", "flowDigest", "screenDigests", "digest"],
          "properties": {
            "targetId": {"$ref": "#/$defs/stableId"}, "kind": {"const": "system"},
            "scope": {"const": "final_flow"}, "flowDigest": {"$ref": "#/$defs/digest"},
            "screenDigests": {
              "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
              "items": {"$ref": "#/$defs/digest"}
            },
            "digest": {"$ref": "#/$defs/digest"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["targetId", "kind", "scope", "appliesTo", "digest"],
          "properties": {
            "targetId": {"$ref": "#/$defs/stableId"}, "kind": {"const": "coverage"},
            "scope": {"const": "rule"}, "appliesTo": {"$ref": "#/$defs/appliesTo"},
            "digest": {"$ref": "#/$defs/digest"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": [
            "targetId", "kind", "scope", "category", "nodeId", "field",
            "identity", "range", "digest"
          ],
          "properties": {
            "targetId": {"$ref": "#/$defs/stableId"}, "kind": {"const": "occurrence"},
            "scope": {"const": "occurrence"}, "category": {"$ref": "#/$defs/text256"},
            "nodeId": {"$ref": "#/$defs/text256"}, "field": {"$ref": "#/$defs/text256"},
            "identity": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/text256"}]},
            "range": {
              "oneOf": [
                {"type": "null"},
                {
                  "type": "object", "additionalProperties": false,
                  "required": ["start", "end"],
                  "properties": {
                    "start": {"type": "integer", "minimum": 0},
                    "end": {"type": "integer", "minimum": 1}
                  }
                }
              ]
            },
            "digest": {"$ref": "#/$defs/digest"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": [
            "targetId", "kind", "scope", "targetDigest", "checkId", "area", "digest"
          ],
          "properties": {
            "targetId": {"$ref": "#/$defs/stableId"}, "kind": {"const": "ux_check"},
            "scope": {"enum": ["screen", "flow"]}, "targetDigest": {"$ref": "#/$defs/digest"},
            "checkId": {"$ref": "#/$defs/text128"}, "area": {"$ref": "#/$defs/text128"},
            "digest": {"$ref": "#/$defs/digest"}
          }
        }
      ]
    },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "digest"],
      "properties": {
        "artifact": {"$ref": "#/$defs/text128"}, "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "findingId", "ruleId", "targetId", "explanation", "impact",
        "evidenceReferences", "correction", "evidenceDigest"
      ],
      "properties": {
        "findingId": {"$ref": "#/$defs/stableId"}, "ruleId": {"$ref": "#/$defs/ruleId"},
        "targetId": {"$ref": "#/$defs/stableId"}, "explanation": {"$ref": "#/$defs/text2048"},
        "impact": {"$ref": "#/$defs/text2048"},
        "evidenceReferences": {
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": {"$ref": "#/$defs/reference"}
        },
        "correction": {"$ref": "#/$defs/text2048"}, "evidenceDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "instance": {
      "type": "object", "additionalProperties": false,
      "required": [
        "instanceId", "source", "ruleId", "target", "rawStatus",
        "incompletenessReason", "findings"
      ],
      "properties": {
        "instanceId": {"$ref": "#/$defs/stableId"},
        "source": {"enum": ["company_rule", "inherited_ux"]},
        "ruleId": {"$ref": "#/$defs/ruleId"}, "target": {"$ref": "#/$defs/target"},
        "rawStatus": {"$ref": "#/$defs/status"},
        "incompletenessReason": {
          "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"}]
        },
        "findings": {
          "type": "array", "maxItems": 256, "uniqueItems": true,
          "items": {"$ref": "#/$defs/finding"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"rawStatus": {"const": "allowed"}}, "required": ["rawStatus"]},
          "then": {
            "properties": {
              "incompletenessReason": {"type": "null"},
              "findings": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"rawStatus": {"const": "conflict"}}, "required": ["rawStatus"]},
          "then": {
            "properties": {
              "incompletenessReason": {"type": "null"},
              "findings": {"minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"rawStatus": {"const": "not_assessed"}}, "required": ["rawStatus"]},
          "then": {
            "properties": {
              "incompletenessReason": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"},
              "findings": {"maxItems": 0}
            }
          }
        }
      ]
    }
  }
}
