{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-system-guardian.local/schemas/profile.schema.json",
  "title": "Design System Guardian company profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "displayName", "figma", "adapters"],
  "properties": {
    "schemaVersion": {"const": 1},
    "profileId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "displayName": {"type": "string", "minLength": 1},
    "figma": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowlistedLibraryFiles"],
      "properties": {
        "allowlistedLibraryFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fileKey"],
            "properties": {
              "fileKey": {"type": "string", "minLength": 1},
              "name": {"type": "string"}
            }
          }
        },
        "allowlistedWorkingFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fileKey"],
            "properties": {
              "fileKey": {"type": "string", "minLength": 1},
              "name": {"type": "string"}
            }
          }
        }
      }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": {"type": "object"},
      "properties": {
        "flutter": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {"enabled": {"const": false}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "platformArtifacts", "requiredPackages"],
              "properties": {
                "enabled": {"const": true},
                "platformArtifacts": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": false,
                  "properties": {
                    "windows-x64": {"$ref": "#/$defs/windowsArtifact"},
                    "windows-arm64": {"$ref": "#/$defs/windowsArtifact"},
                    "linux-x64": {"$ref": "#/$defs/unixArtifact"},
                    "linux-arm64": {"$ref": "#/$defs/unixArtifact"},
                    "macos-x64": {"$ref": "#/$defs/unixArtifact"},
                    "macos-arm64": {"$ref": "#/$defs/unixArtifact"}
                  }
                },
                "requiredPackages": {
                  "type": "object",
                  "required": ["flutter"],
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^(?!design_system_guardian_flutter$)[a-z][a-z0-9_]*$"
                  },
                  "additionalProperties": {"$ref": "#/$defs/packageBinding"}
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repositoryCommit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "packageBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentDigest", "repositoryCommit"],
      "properties": {
        "contentDigest": {"$ref": "#/$defs/digest"},
        "repositoryCommit": {"$ref": "#/$defs/repositoryCommit"}
      }
    },
    "windowsArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dartSdk"],
      "properties": {
        "dartSdk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contentDigest", "executableRelativePath"],
          "properties": {
            "contentDigest": {"$ref": "#/$defs/digest"},
            "executableRelativePath": {"const": "bin/dart.exe"}
          }
        }
      }
    },
    "unixArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dartSdk"],
      "properties": {
        "dartSdk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contentDigest", "executableRelativePath"],
          "properties": {
            "contentDigest": {"$ref": "#/$defs/digest"},
            "executableRelativePath": {"const": "bin/dart"}
          }
        }
      }
    }
  }
}
