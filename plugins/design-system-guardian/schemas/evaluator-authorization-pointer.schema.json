{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-system-guardian.local/schemas/evaluator-authorization-pointer.schema.json",
  "title": "Design System Guardian current evaluator authorization pointer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "profileId", "profileDigest", "policyDigest",
    "authorizationSequence", "authorizationDigest", "evaluatorId",
    "evaluatorContractDigest", "authoritySeal"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "profileId": {"$ref": "snapshot.schema.json#/$defs/profileId"},
    "profileDigest": {"$ref": "snapshot.schema.json#/$defs/digest"},
    "policyDigest": {"$ref": "snapshot.schema.json#/$defs/digest"},
    "authorizationSequence": {"const": 1},
    "authorizationDigest": {"$ref": "snapshot.schema.json#/$defs/digest"},
    "evaluatorId": {"const": "guardian-flutter-usage-rules-v2"},
    "evaluatorContractDigest": {"const": "24b38e5b0a7ffe35da9cb368613c693e42e95937d599922491aac2fced411846"},
    "authoritySeal": {"$ref": "snapshot.schema.json#/$defs/digest"}
  }
}
