{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-system-guardian.local/schemas/evolution/elo-ledger-entry.schema.json",
  "title": "Design System Guardian authority-sealed Elo ledger entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "model", "sequence", "previousEntryDigest", "entryDigest",
    "pluginName", "policyDigest", "suiteDigest", "runtimeDigest",
    "baselineResultDigest", "candidateResultDigest", "baselineVersion", "candidateVersion",
    "baselineCommit", "candidateCommit", "previousScore", "categoryDeltas", "delta", "score",
    "achievementIds", "newAchievementIds", "confirmedRegressionIds", "authoritySeal"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "model": {"const": "guardian-weighted-elo-v1"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "previousEntryDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "entryDigest": {"$ref": "#/$defs/digest"},
    "pluginName": {"const": "design-system-guardian"},
    "policyDigest": {"const": "3bf2913583cee2d791aed5093bc1df905b26dcdbb0c4d945f0ae5b2eddaaa99f"},
    "suiteDigest": {"$ref": "#/$defs/digest"},
    "runtimeDigest": {"$ref": "#/$defs/digest"},
    "baselineResultDigest": {"$ref": "#/$defs/digest"},
    "candidateResultDigest": {"$ref": "#/$defs/digest"},
    "baselineVersion": {"$ref": "#/$defs/semver"},
    "candidateVersion": {"$ref": "#/$defs/semver"},
    "baselineCommit": {"$ref": "#/$defs/commit"},
    "candidateCommit": {"$ref": "#/$defs/commit"},
    "previousScore": {"type": "integer", "minimum": 1, "maximum": 2000},
    "categoryDeltas": {
      "type": "object", "additionalProperties": false,
      "required": ["correctness", "reliability", "coverage_usefulness", "safety_privacy_integrity", "portability_usability_performance"],
      "properties": {
        "correctness": {"type": "integer", "minimum": -80, "maximum": 80},
        "reliability": {"type": "integer", "minimum": -40, "maximum": 40},
        "coverage_usefulness": {"type": "integer", "minimum": -30, "maximum": 30},
        "safety_privacy_integrity": {"type": "integer", "minimum": -30, "maximum": 30},
        "portability_usability_performance": {"type": "integer", "minimum": -20, "maximum": 20}
      }
    },
    "delta": {"type": "integer", "minimum": -200, "maximum": 200},
    "score": {"type": "integer", "minimum": 1, "maximum": 2000},
    "achievementIds": {"$ref": "#/$defs/achievementIds"},
    "newAchievementIds": {"$ref": "#/$defs/achievementIds"},
    "confirmedRegressionIds": {"$ref": "#/$defs/achievementIds"},
    "authoritySeal": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "achievementId": {"type": "string", "pattern": "^synthetic-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 127},
    "achievementIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/achievementId"}},
    "commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"}
  }
}
