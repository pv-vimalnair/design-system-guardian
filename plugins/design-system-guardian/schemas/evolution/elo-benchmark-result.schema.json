{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-system-guardian.local/schemas/evolution/elo-benchmark-result.schema.json",
  "title": "Design System Guardian public synthetic Elo benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "model", "suiteDigest", "policyDigest", "runtimeDigest",
    "pluginVersion", "sourceCommit", "passedAchievementIds", "regressions"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "model": {"const": "guardian-weighted-elo-v1"},
    "suiteDigest": {"$ref": "#/$defs/digest"},
    "policyDigest": {"const": "3bf2913583cee2d791aed5093bc1df905b26dcdbb0c4d945f0ae5b2eddaaa99f"},
    "runtimeDigest": {"$ref": "#/$defs/digest"},
    "pluginVersion": {"$ref": "#/$defs/semver"},
    "sourceCommit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "passedAchievementIds": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/achievementId"}
    },
    "regressions": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["achievementId", "attribution", "conditionDigest", "reproductionDigests"],
        "properties": {
          "achievementId": {"$ref": "#/$defs/achievementId"},
          "attribution": {"enum": ["guardian", "external", "source", "project", "project_configuration"]},
          "conditionDigest": {"$ref": "#/$defs/digest"},
          "reproductionDigests": {
            "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
            "items": {"$ref": "#/$defs/digest"}
          }
        }
      }
    }
  },
  "$defs": {
    "achievementId": {"type": "string", "pattern": "^synthetic-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 127},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"}
  }
}
