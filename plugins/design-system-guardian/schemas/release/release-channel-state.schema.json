{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-system-guardian.local/schemas/release/release-channel-state.schema.json",
  "title": "Design System Guardian release channel state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "channel",
    "channelSequence",
    "actionManifestDigest",
    "activeManifestDigest",
    "pluginVersion",
    "sourceCommit",
    "artifactDigest",
    "policyDigest",
    "canaryEvidenceDigest",
    "eventRecordedAt",
    "activatedAt",
    "authoritySeal"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "channel": { "enum": ["canary", "stable"] },
    "channelSequence": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "actionManifestDigest": { "$ref": "#/$defs/sha256" },
    "activeManifestDigest": { "$ref": "#/$defs/sha256" },
    "pluginVersion": { "$ref": "#/$defs/semver" },
    "sourceCommit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "artifactDigest": { "$ref": "#/$defs/sha256" },
    "policyDigest": { "const": "3bf2913583cee2d791aed5093bc1df905b26dcdbb0c4d945f0ae5b2eddaaa99f" },
    "canaryEvidenceDigest": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "eventRecordedAt": { "$ref": "#/$defs/timestamp" },
    "activatedAt": { "$ref": "#/$defs/timestamp" },
    "authoritySeal": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "channel": { "const": "canary" } } },
      "then": {
        "properties": { "canaryEvidenceDigest": { "type": "null" } }
      }
    },
    {
      "if": { "properties": { "channel": { "const": "stable" } } },
      "then": {
        "properties": {
          "canaryEvidenceDigest": { "$ref": "#/$defs/sha256" },
          "pluginVersion": { "$ref": "#/$defs/stableSemver" }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "stableSemver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    }
  }
}
