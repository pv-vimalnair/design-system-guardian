{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-system-guardian.local/schemas/evaluator-authorization-record.schema.json",
  "title": "Design System Guardian immutable evaluator authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "authorizationSequence", "previousAuthorizationDigest",
    "profileId", "profileDigest", "policyDigest", "ruleSnapshotId",
    "ruleSnapshotApprovalSequence", "rulesDigest", "sourceCutDigest",
    "activationPermissionDigest", "catalogAuthorityKeyId", "previousEvaluatorId",
    "evaluatorId", "evaluatorContractDigest", "capabilityMatrix",
    "namespaceTarget", "targetAuthorizationSchemaVersion", "immutable",
    "authorizationDigest", "authoritySeal"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "authorizationSequence": {"const": 1},
    "previousAuthorizationDigest": {"const": null},
    "profileId": {"$ref": "snapshot.schema.json#/$defs/profileId"},
    "profileDigest": {"$ref": "snapshot.schema.json#/$defs/digest"},
    "policyDigest": {"$ref": "snapshot.schema.json#/$defs/digest"},
    "ruleSnapshotId": {"$ref": "snapshot.schema.json#/$defs/digest"},
    "ruleSnapshotApprovalSequence": {"$ref": "snapshot.schema.json#/$defs/approvalSequence"},
    "rulesDigest": {"$ref": "snapshot.schema.json#/$defs/digest"},
    "sourceCutDigest": {"$ref": "snapshot.schema.json#/$defs/digest"},
    "activationPermissionDigest": {"$ref": "snapshot.schema.json#/$defs/digest"},
    "catalogAuthorityKeyId": {"$ref": "snapshot.schema.json#/$defs/digest"},
    "previousEvaluatorId": {"const": "guardian-flutter-usage-rules-v1"},
    "evaluatorId": {"const": "guardian-flutter-usage-rules-v2"},
    "evaluatorContractDigest": {"const": "24b38e5b0a7ffe35da9cb368613c693e42e95937d599922491aac2fced411846"},
    "capabilityMatrix": {"$ref": "evaluator-upgrade-permission.schema.json#/$defs/capabilityMatrix"},
    "namespaceTarget": {"const": "evaluator-authorizations-v1"},
    "targetAuthorizationSchemaVersion": {"const": 1},
    "immutable": {"const": true},
    "authorizationDigest": {"$ref": "snapshot.schema.json#/$defs/digest"},
    "authoritySeal": {"$ref": "snapshot.schema.json#/$defs/digest"}
  }
}
