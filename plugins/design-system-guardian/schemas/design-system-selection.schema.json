{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pv-vimalnair/design-system-guardian/schemas/design-system-selection.schema.json",
  "title": "Design System Guardian personal task selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorityMode",
    "runId",
    "profileId",
    "profileDigest",
    "snapshotId",
    "catalogDigest",
    "policyDigest",
    "projectBindingDigest",
    "targetFigmaFile",
    "libraryDecisions",
    "selectedLibraryFileKeys",
    "excludedLibraryFileKeys",
    "selectionSetDigest",
    "permissionBindingDigest",
    "catalogReadbackDigest",
    "discoveryDigest",
    "selectionDigest",
    "authoritySeal"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "authorityMode": {"const": "personal_local"},
    "runId": {"$ref": "#/$defs/identity"},
    "profileId": {"type": "string", "pattern": "^personal-[0-9a-f]{40}$"},
    "profileDigest": {"$ref": "#/$defs/digest"},
    "snapshotId": {"$ref": "#/$defs/digest"},
    "catalogDigest": {"$ref": "#/$defs/digest"},
    "policyDigest": {
      "const": "3bf2913583cee2d791aed5093bc1df905b26dcdbb0c4d945f0ae5b2eddaaa99f"
    },
    "projectBindingDigest": {"$ref": "#/$defs/digest"},
    "targetFigmaFile": {"$ref": "#/$defs/fileIdentity"},
    "libraryDecisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/libraryDecision"}
    },
    "selectedLibraryFileKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identity"}
    },
    "excludedLibraryFileKeys": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identity"}
    },
    "selectionSetDigest": {"$ref": "#/$defs/digest"},
    "permissionBindingDigest": {"$ref": "#/$defs/digest"},
    "catalogReadbackDigest": {"$ref": "#/$defs/digest"},
    "discoveryDigest": {"$ref": "#/$defs/digest"},
    "selectionDigest": {"$ref": "#/$defs/digest"},
    "authoritySeal": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileKey", "version"],
      "properties": {
        "fileKey": {"$ref": "#/$defs/identity"},
        "version": {"$ref": "#/$defs/identity"}
      }
    },
    "libraryDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileKey", "version", "published", "decision"],
      "properties": {
        "fileKey": {"$ref": "#/$defs/identity"},
        "version": {"$ref": "#/$defs/identity"},
        "published": {"type": "boolean"},
        "decision": {"enum": ["use", "do_not_use"]}
      }
    }
  }
}
