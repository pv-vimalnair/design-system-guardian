{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-system-guardian.invalid/schemas/flutter-suppression-scan-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "method", "astProof", "findings"],
  "properties": {
    "schemaVersion": {"const": 1},
    "method": {"const": "conservative_text_scan"},
    "astProof": {"const": false},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "line", "text", "kind"],
        "properties": {
          "path": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "text": {"type": "string"},
          "kind": {
            "enum": ["source_ignore", "diagnostic_disable", "guardian_bypass_marker"]
          }
        }
      }
    }
  }
}
